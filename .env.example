APP_NAME=Bazart API
ENVIRONMENT=local
# Port 5433: docker compose'dagi Postgres. 5432 ni mahalliy o'rnatilgan
# Postgres egallashi mumkin — u holda ilova noto'g'ri bazaga ulanadi.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/bazart
# Testlar uchun alohida baza (avtomatik yaratiladi)
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/bazart_test
SECRET_KEY=change-me-in-production-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# O'suvchi (ingliz) auksion: false — yangi o'suvchi auksion yaratilmaydi va UI'da yashiriladi;
# mavjudlari o'z qoidasida tugaydi. Qayta yoqish — true (migratsiyasiz). docs/AUCTION_ENGINE.md §14
FEATURE_ASCENDING_AUCTION=false
# Sessiya (docs/AUTH.md): refresh token HttpOnly cookie'da, har yangilanishda almashadi.
# Login'dan shuncha kun o'tgach sessiya albatta tugaydi (sirpanuvchi muddatdan qat'i nazar).
REFRESH_SESSION_MAX_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=10
# Berilmasa: prod/staging'da Secure, local'da yo'q (http://localhost). Prod'da o'chirib bo'lmaydi.
# REFRESH_COOKIE_SECURE=true
# Lax: frontend va API bitta saytda (bazart.uz + api.bazart.uz). Domain berilmasa — faqat API hosti (eng xavfsiz).
REFRESH_COOKIE_SAMESITE=lax
# REFRESH_COOKIE_DOMAIN=
# Frontend origin'lari (JSON). CORS va /auth/refresh, /auth/logout Origin tekshiruvi shu ro'yxat.
CORS_ORIGINS=["http://localhost:3000"]
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=60
SOFT_CLOSE_WINDOW_SECONDS=120
SOFT_CLOSE_EXTENSION_SECONDS=120
LOCAL_UPLOAD_DIR=uploads
PUBLIC_UPLOAD_URL_PREFIX=/uploads

# Google orqali kirish (OAuth Web Client ID). Bo'sh = /auth/google o'chiq.
GOOGLE_CLIENT_ID=

# Xabarnomalar: Telegram (asosiy kanal). Token bo'sh yoki ENABLED=false — faqat log.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Telegram xabarlaridagi lot/buyurtma havolasi uchun sayt manzili (bo'sh — havolasiz).
PUBLIC_SITE_URL=
# "Tugashiga N soat qoldi" eslatmasi (daqiqa) va "narx tushdi" chegarasi (1000 = 10%).
ENDING_SOON_LEAD_MINUTES=120
PRICE_DROP_NOTIFY_MIN_BPS=1000
